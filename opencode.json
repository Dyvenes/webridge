{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "webbridge/deepseek-chat",
  "experimental": {
    "subagent_depth": 2
  },
  "providers": {
    "webbridge": {
      "name": "WebBridge",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "local",
        "headerTimeout": 600000,
        "chunkTimeout": false
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat (web)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 64000,
            "output": 8192
          }
        },
        "deepseek-reasoner": {
          "name": "DeepSeek Reasoner (web)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 64000,
            "output": 8192
          }
        },
        "claude-sonnet": {
          "name": "Claude Sonnet (web)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "claude-opus": {
          "name": "Claude Opus (web)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 8192
          }
        }
      }
    }
  }
}
